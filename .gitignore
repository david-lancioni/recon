# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
etc/environment.txt
job/run.env

# Runtime data - a estrutura de pastas é versionada, mas o conteúdo gerado
# pelo processamento dos usuários não deve ser versionado nem sobrescrito
# pelo git pull do deploy.sh
/data/**
!/data/**/
!/data/**/.gitkeep

# Distribution / build
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
