# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
etc/environment.txt

# Runtime data - nunca deve ser versionado nem sobrescrito pelo git pull do deploy.sh
/data/

